# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.waha_data/
.waha_sessions/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep real local env ignored, but track safe example template)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
.worktrees/

# local agent artifacts
.codex
# docs: keep operational docs tracked, ignore working notes & phase logs
/docs/plans/
/docs/phase-[0-9]*/
/docs/20[0-9][0-9]-*
/conference-paper/
/tests/
/testapi/
/scripts/
/.agents/
/.kilocode/
/.codex/
/check_templates.mjs
/debug_onstay.mjs

# Claude AI and worktree artifacts
.claude/
.worktrees/

# Session backups
.waha_sessions_backup/

# Local workspace files
*.code-workspace
