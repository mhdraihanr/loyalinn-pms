# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WAHA Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-waha-api-key
WAHA_WEBHOOK_SECRET=your-waha-webhook-secret
WAHA_WEBHOOK_AUTH_DISABLED=true
WAHA_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/waha
WAHA_WEBHOOK_EVENTS=message.any
WAHA_AUTO_CONFIGURE_WEBHOOKS=false
WAHA_NOWEB_STORE_ENABLED=true
WAHA_NOWEB_FULL_SYNC=true

# PMS Webhook Configuration
PMS_WEBHOOK_SECRET=your-webhook-secret
PMS_RECONCILIATION_ENABLED=false
PMS_RECONCILIATION_CRON_SECRET=your-pms-reconciliation-cron-secret

# Cron Configuration
CRON_SECRET=your-cron-secret

# Development Scheduler Configuration
DEV_AUTOMATION_SYNC_INTERVAL_MS=1000
DEV_AUTOMATION_SYNC_ENABLED=true

# AI Provider Configuration
# Supported values: gemini, 9router
AI_PROVIDER=gemini

# Gemini Configuration
# Either GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY can be used.
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
GEMINI_MODEL=gemini-2.5-flash

# 9Router Configuration (OpenAI-compatible gateway)
# Start 9Router locally, then verify with: curl $NINEROUTER_URL/api/health
# NINEROUTER_BASE_URL is also supported; /v1 is appended automatically when omitted.
NINEROUTER_URL=http://localhost:20128
# Either NINEROUTER_KEY or NINEROUTER_API_KEY can be used; leave blank if local 9Router auth is disabled.
NINEROUTER_KEY=your-9router-api-key
# NINEROUTER_API_KEY=your-9router-api-key
# Use an id returned by: curl $NINEROUTER_URL/v1/models
NINEROUTER_MODEL=kr/claude-sonnet-4.5

LIFECYCLE_AI_DEBUG=true